{
	"name": "DataflowDAYENDHISTORIC",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ParquetOUTPUTHISTORIC",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "S_TicketTable",
						"type": "DatasetReference"
					},
					"name": "sinkTicket"
				},
				{
					"dataset": {
						"referenceName": "S_PaymodeTable",
						"type": "DatasetReference"
					},
					"name": "sinkPaymode"
				},
				{
					"dataset": {
						"referenceName": "S_OrderTable",
						"type": "DatasetReference"
					},
					"name": "sinkOrder"
				},
				{
					"dataset": {
						"referenceName": "S_LinesTable",
						"type": "DatasetReference"
					},
					"name": "sinkLines"
				}
			],
			"transformations": [
				{
					"name": "MapDrifted",
					"description": "Creates an explicit mapping for each drifted column"
				},
				{
					"name": "selectTicket"
				},
				{
					"name": "selectLines"
				},
				{
					"name": "selectOrder"
				},
				{
					"name": "selectPayments"
				},
				{
					"name": "filterNULLpayments"
				},
				{
					"name": "filterNULLlines"
				},
				{
					"name": "windowDuplicateTicket"
				},
				{
					"name": "filterDuplicateTicket"
				},
				{
					"name": "windowDuplicatePaymode"
				},
				{
					"name": "filterDuplicatePaymode"
				},
				{
					"name": "windowDuplicateOrder"
				},
				{
					"name": "filterDuplicateOrder"
				},
				{
					"name": "AlterRow1"
				},
				{
					"name": "AlterRow2"
				},
				{
					"name": "AlterRow3"
				},
				{
					"name": "AlterRow4"
				},
				{
					"name": "RemoveRowNumOrder"
				},
				{
					"name": "RemoverRowNumPaymode"
				},
				{
					"name": "RemoverRowNumTicket"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SourceFileName as string,",
				"          TicketKey as string,",
				"          TicketActualDate as long,",
				"          TableNr as string,",
				"          CenterKey as string,",
				"          CenterName as string,",
				"          Covers as string,",
				"          TicketDate as long,",
				"          PcName as string,",
				"          TicketNr as long,",
				"          TicketTime as string,",
				"          TotalPrice as double,",
				"          TotalToPay as double,",
				"          TicketUserName as string,",
				"          Internal as string,",
				"          OrderKey as string,",
				"          ActionId as string,",
				"          OrderActualDate as long,",
				"          OrderDate as long,",
				"          OrderTime as string,",
				"          OrderUserName as string,",
				"          OrderUserKey as string,",
				"          LineKey as string,",
				"          LineGroupKey as string,",
				"          LineGroupName as string,",
				"          LinePrice as double,",
				"          LineProductKey as string,",
				"          LineProductName as string,",
				"          LineProductNr as long,",
				"          LineQty as long,",
				"          LineTotalEx as double,",
				"          LineTotalInc as double,",
				"          LineVatPerc as long,",
				"          IsAddon as boolean,",
				"          ParentLineKey as string,",
				"          PaymodeKey as string,",
				"          PaymodeGroupKey as string,",
				"          PaymodeGroupName as string,",
				"          PaymodePaymodeKey as string,",
				"          PaymodePaymodeName as string,",
				"          PaymodePaymodeNr as long,",
				"          PaymodePaymodeType as string,",
				"          PaymodePrice as double,",
				"          PaymodeQty as long,",
				"          PaymodeTotal as double,",
				"          PaymodeMemo as string,",
				"          PaymodeTerminalId as string,",
				"          PaymodeTransactionId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     purgeFiles: true,",
				"     format: 'parquet') ~> source1",
				"source1 derive(SourceFileName = toString(byName('SourceFileName')),",
				"          TicketKey = toString(byName('TicketKey')),",
				"          TicketActualDate = toLong(byName('TicketActualDate')),",
				"          CenterKey = toString(byName('CenterKey')),",
				"          CenterName = toString(byName('CenterName')),",
				"          Covers = toString(byName('Covers')),",
				"          TicketDate = toLong(byName('TicketDate')),",
				"          PcName = toString(byName('PcName')),",
				"          TicketNr = toLong(byName('TicketNr')),",
				"          TicketTime = toString(byName('TicketTime')),",
				"          TotalPrice = toDouble(byName('TotalPrice')),",
				"          TotalToPay = toDouble(byName('TotalToPay')),",
				"          TicketUserName = toString(byName('TicketUserName')),",
				"          OrderKey = toString(byName('OrderKey')),",
				"          ActionId = toString(byName('ActionId')),",
				"          OrderActualDate = toLong(byName('OrderActualDate')),",
				"          OrderDate = toLong(byName('OrderDate')),",
				"          OrderTime = toString(byName('OrderTime')),",
				"          OrderUserName = toString(byName('OrderUserName')),",
				"          OrderUserKey = toString(byName('OrderUserKey')),",
				"          LineKey = toString(byName('LineKey')),",
				"          LineGroupKey = toString(byName('LineGroupKey')),",
				"          LineGroupName = toString(byName('LineGroupName')),",
				"          LinePrice = toDouble(byName('LinePrice')),",
				"          LineProductKey = toString(byName('LineProductKey')),",
				"          LineProductName = toString(byName('LineProductName')),",
				"          LineProductNr = toLong(byName('LineProductNr')),",
				"          LineQty = toLong(byName('LineQty')),",
				"          LineTotalEx = toDouble(byName('LineTotalEx')),",
				"          LineTotalInc = toDouble(byName('LineTotalInc')),",
				"          LineVatPerc = toLong(byName('LineVatPerc')),",
				"          PaymodeKey = toString(byName('PaymodeKey')),",
				"          PaymodeGroupKey = toString(byName('PaymodeGroupKey')),",
				"          PaymodeGroupName = toString(byName('PaymodeGroupName')),",
				"          PaymodePaymodeKey = toString(byName('PaymodePaymodeKey')),",
				"          PaymodePaymodeName = toString(byName('PaymodePaymodeName')),",
				"          PaymodePaymodeNr = toLong(byName('PaymodePaymodeNr')),",
				"          PaymodePaymodeType = toString(byName('PaymodePaymodeType')),",
				"          PaymodePrice = toDouble(byName('PaymodePrice')),",
				"          PaymodeQty = toLong(byName('PaymodeQty')),",
				"          PaymodeTotal = toDouble(byName('PaymodeTotal')),",
				"          PaymodeMemo = toString(byName('PaymodeMemo')),",
				"          PaymodeTerminalId = toString(byName('PaymodeTerminalId')),",
				"          PaymodeTransactionId = toString(byName('PaymodeTransactionId')),",
				"          TableNr = toString(byName('TableNr')),",
				"          IsAddon = toBoolean(byName('IsAddon')),",
				"          ParentLineKey = toString(byName('ParentLineKey')),",
				"          Internal = toString(byName('Internal'))) ~> MapDrifted",
				"MapDrifted select(mapColumn(",
				"          TicketKey,",
				"          TicketDate,",
				"          TicketTime,",
				"          TicketActualDate,",
				"          CenterKey,",
				"          CenterName,",
				"          Covers,",
				"          PcName,",
				"          TicketNr,",
				"          TotalPrice,",
				"          TotalToPay,",
				"          TicketUserName,",
				"          Internal,",
				"          TableNr",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTicket",
				"MapDrifted select(mapColumn(",
				"          TicketKey,",
				"          OrderKey,",
				"          LineKey,",
				"          LineGroupKey,",
				"          LineGroupName,",
				"          LinePrice,",
				"          LineProductKey,",
				"          LineProductName,",
				"          LineProductNr,",
				"          LineQty,",
				"          LineTotalEx,",
				"          LineTotalInc,",
				"          LineVatPerc,",
				"          CenterKey,",
				"          CenterName,",
				"          IsAddon,",
				"          ParentLineKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectLines",
				"MapDrifted select(mapColumn(",
				"          TicketKey,",
				"          OrderKey,",
				"          ActionId,",
				"          OrderDate,",
				"          OrderTime,",
				"          OrderUserName,",
				"          OrderUserKey,",
				"          CenterKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectOrder",
				"MapDrifted select(mapColumn(",
				"          TicketKey,",
				"          PaymodeKey,",
				"          PaymodeGroupKey,",
				"          PaymodeGroupName,",
				"          PaymodePaymodeKey,",
				"          PaymodePaymodeName,",
				"          PaymodePaymodeNr,",
				"          PaymodePaymodeType,",
				"          PaymodePrice,",
				"          PaymodeQty,",
				"          PaymodeTotal,",
				"          PaymodeMemo,",
				"          PaymodeTerminalId,",
				"          PaymodeTransactionId,",
				"          CenterKey,",
				"          CenterName",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> selectPayments",
				"selectPayments filter(!isNull(PaymodeKey)) ~> filterNULLpayments",
				"selectLines filter(!isNull(LineKey)) ~> filterNULLlines",
				"selectTicket window(over(TicketKey),",
				"     asc(TicketKey, true),",
				"     RowNum = rowNumber()) ~> windowDuplicateTicket",
				"windowDuplicateTicket filter(RowNum == 1) ~> filterDuplicateTicket",
				"filterNULLpayments window(over(TicketKey,",
				"          PaymodeKey,",
				"          PaymodeGroupKey),",
				"     asc(TicketKey, true),",
				"     RowNum = rowNumber()) ~> windowDuplicatePaymode",
				"windowDuplicatePaymode filter(RowNum == 1) ~> filterDuplicatePaymode",
				"selectOrder window(over(TicketKey,",
				"          OrderKey),",
				"     asc(OrderKey, true),",
				"     RowNum = rowNumber()) ~> windowDuplicateOrder",
				"windowDuplicateOrder filter(RowNum == 1) ~> filterDuplicateOrder",
				"RemoverRowNumPaymode alterRow(upsertIf(true())) ~> AlterRow1",
				"RemoveRowNumOrder alterRow(upsertIf(true())) ~> AlterRow2",
				"filterNULLlines alterRow(upsertIf(true())) ~> AlterRow3",
				"RemoverRowNumTicket alterRow(upsertIf(true())) ~> AlterRow4",
				"filterDuplicateOrder select(mapColumn(",
				"          TicketKey,",
				"          OrderKey,",
				"          ActionId,",
				"          OrderDate,",
				"          OrderTime,",
				"          OrderUserName,",
				"          OrderUserKey,",
				"          CenterKey",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveRowNumOrder",
				"filterDuplicatePaymode select(mapColumn(",
				"          TicketKey,",
				"          PaymodeKey,",
				"          PaymodeGroupKey,",
				"          PaymodeGroupName,",
				"          PaymodePaymodeKey,",
				"          PaymodePaymodeName,",
				"          PaymodePaymodeNr,",
				"          PaymodePaymodeType,",
				"          PaymodePrice,",
				"          PaymodeQty,",
				"          PaymodeTotal,",
				"          PaymodeMemo,",
				"          PaymodeTerminalId,",
				"          PaymodeTransactionId,",
				"          CenterKey,",
				"          CenterName",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoverRowNumPaymode",
				"filterDuplicateTicket select(mapColumn(",
				"          TicketKey,",
				"          TicketDate,",
				"          TicketTime,",
				"          TicketActualDate,",
				"          CenterKey,",
				"          CenterName,",
				"          Covers,",
				"          PcName,",
				"          TicketNr,",
				"          TotalPrice,",
				"          TotalToPay,",
				"          TicketUserName,",
				"          Internal,",
				"          TableNr",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoverRowNumTicket",
				"AlterRow4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['TicketKey'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkTicket",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['TicketKey','PaymodeKey','PaymodeGroupKey','PaymodePaymodeKey','PaymodeTransactionId','PaymodeMemo'],",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkPaymode",
				"AlterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['TicketKey','OrderKey'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkOrder",
				"AlterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['TicketKey','OrderKey','LineKey'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkLines"
			]
		}
	}
}