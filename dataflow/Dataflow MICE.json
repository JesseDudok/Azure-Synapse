				"          event_status as string,",
				"          event_start as string,",
				"          event_end as string,",
				"          event_guests as long,",
				"          event_url as string,",
				"          company_id as long,",
				"          planner_id as long,",
				"          client_id as long,",
				"          event_location_id as long,",
				"          planner_detail_id as long,",
				"          planner_name as string,",
				"          planner_email as string,",
				"          event_type_detail_id as long,",
				"          event_type_name as string,",
				"          activity_id as long,",
				"          activity_name as string,",
				"          product_id as long,",
				"          object_type as string,",
				"          object_id as long,",
				"          object_code as string,",
				"          object_category_id as long,",
				"          product_event_id as long,",
				"          event_timeline_id as long,",
				"          event_activity_id as long,",
				"          event_package_id as long,",
				"          amount as long,",
				"          amount_pp as long,",
				"          product_name as string,",
				"          subtitle as string,",
				"          description as string,",
				"          price as double,",
				"          price_excl_vat as double,",
				"          total_price as double,",
				"          total_price_excl_vat as double,",
				"          cost_price as double,",
				"          vat as double,",
				"          product_source as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTPRODUCTS",
				"source(output(",
				"          event_id as long,",
				"          event_name as string,",
				"          event_status as string,",
				"          company_id as long,",
				"          planner_id as long,",
				"          client_id as long,",
				"          event_location_id as long,",
				"          package_id as long,",
				"          package_name as string,",
				"          package_description as string,",
				"          package_price as double,",
				"          package_price_excl_vat as double,",
				"          package_total_price as double,",
				"          package_total_price_excl_vat as double,",
				"          package_source as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTPACKAGES",
				"source(output(",
				"          product_id as long,",
				"          event_id as long,",
				"          activity_id as long,",
				"          product_name as string,",
				"          object_id as long,",
				"          vat_rate as double,",
				"          vat_amount as double,",
				"          vat_price as double,",
				"          vat_price_excl as double,",
				"          general_ledger_number as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTVATRATES",
				"source(output(",
				"          invoice_id as long,",
				"          invoice_nr as long,",
				"          draft_nr as long,",
				"          company_id as long,",
				"          client_id as long,",
				"          client_name as string,",
				"          invoice_status as string,",
				"          invoice_description as string,",
				"          invoice_total_excl_vat as double,",
				"          invoice_total_vat as double,",
				"          invoice_total_incl_vat as double,",
				"          invoice_total_discount as double,",
				"          invoice_created as string,",
				"          invoice_updated as string,",
				"          invoice_reference as string,",
				"          payment_term as long,",
				"          invoice_incl_vat as boolean,",
				"          line_event_id as long,",
				"          line_object_type as string,",
				"          line_object_id as long,",
				"          line_object_code as string,",
				"          line_date as string,",
				"          line_amount as double,",
				"          line_description as string,",
				"          line_vat_rate as double,",
				"          line_vat_amount as double,",
				"          line_price as double,",
				"          line_price_excl_vat as double,",
				"          line_total_price as double,",
				"          line_total_price_excl_vat as double,",
				"          line_total_vat as double,",
				"          line_invoicing_number as string,",
				"          line_general_ledger_number as string,",
				"          line_cost_center as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> INVOICELINES",
				"source(output(",
				"          product_id as long,",
				"          product_name as string,",
				"          product_group_id as long,",
				"          category_id as long,",
				"          category_name as string,",
				"          vat_rate as double,",
				"          vat_amount as double,",
				"          vat_price as double,",
				"          vat_price_excl as double,",
				"          vat_general_ledger_number as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> PRODUCTVATRATES",
				"source(output(",
				"          category_id as long,",
				"          category_name as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> PRODUCTCATEGORIES",
				"source(output(",
				"          event_id as long,",
				"          event_name as string,",
				"          client_id as long,",
				"          contact_id as long,",
				"          first_name as string,",
				"          last_name as string,",
				"          full_name as string,",
				"          email as string,",
				"          phone as string,",
				"          role as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTCONTACTS",
				"source(output(",
				"          event_id as long,",
				"          event_name as string,",
				"          client_id as long,",
				"          company_id as long,",
				"          planner_id as long,",
				"          notities_niet_op_werkbrief as string,",
				"          poinkoopnummer as string,",
				"          poinkoopordernummer as string,",
				"          fb_aantekeningen as string,",
				"          opstelling as string,",
				"          leveranciers as string,",
				"          decoratie as string,",
				"          gasten as string,",
				"          betaalwijze_raw as string,",
				"          locatie as string,",
				"          accountmanager as string,",
				"          producent as string,",
				"          slagingskans as string,",
				"          handtekening as string,",
				"          notities_wel_op_de_werkbrief as string,",
				"          opbouw_en_draaiduty as string,",
				"          custom_datum as string,",
				"          personeel as string,",
				"          opstelling_turbinehal as string,",
				"          opstelling_megawatt as string,",
				"          opstelling_voltage_ingang as string,",
				"          opstelling_machinekamer_1 as string,",
				"          opstelling_machinekamer_2 as string,",
				"          opstelling_schakelruimte as string,",
				"          catering as string,",
				"          crewcatering as string,",
				"          techniek as string,",
				"          bijzonderheden as string,",
				"          label as string,",
				"          basisvoorziening as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTCUSTOMATTRIBUTES",
				"source(output(",
				"          planner_id as long,",
				"          first_name as string,",
				"          last_name as string,",
				"          full_name as string,",
				"          email as string,",
				"          phone as string,",
				"          avatar_url as string,",
				"          initials as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTPLANNER",
				"source(output(",
				"          event_type_id as long,",
				"          event_type_name as string,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> EVENTTYPES",
				"source(output(",
				"          event_id as long,",
				"          event_name as string,",
				"          event_status as string,",
				"          event_start as string,",
				"          event_end as string,",
				"          event_guests as long,",
				"          company_id as long,",
				"          planner_id as long,",
				"          client_id as long,",
				"          location_id as long,",
				"          event_total_price as double,",
				"          event_total_price_excl_vat as double,",
				"          event_url as string,",
				"          created as string,",
				"          updated as string,",
				"          booking_id as long,",
				"          reference as string,",
				"          event_type_id as long,",
				"          locale as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceEventsTable",
				"EVENTS derive(event_id = toLong(byName('event_id')),",
				"          event_name = toString(byName('event_name')),",
				"          event_status = toString(byName('event_status')),",
				"          event_start = toString(byName('event_start')),",
				"          event_end = toString(byName('event_end')),",
				"          event_guests = toLong(byName('event_guests')),",
				"          company_id = toLong(byName('company_id')),",
				"          planner_id = toLong(byName('planner_id')),",
				"          client_id = toLong(byName('client_id')),",
				"          location_id = toLong(byName('location_id')),",
				"          event_total_price = toDouble(byName('event_total_price')),",
				"          event_total_price_excl_vat = toDouble(byName('event_total_price_excl_vat')),",
				"          created = toString(byName('created')),",
				"          updated = toString(byName('updated')),",
				"          booking_id = toLong(byName('booking_id')),",
				"          reference = toString(byName('reference')),",
				"          event_type_id = toLong(byName('event_type_id')),",
				"          locale = toString(byName('locale')),",
				"          event_url = toString(byName('event_url'))) ~> MapDrifted1",
				"CLIENTS derive(id = toInteger(byName('id')),",
				"          created = toString(byName('created')),",
				"          updated = toString(byName('updated')),",
				"          type = toString(byName('type')),",
				"          name = toString(byName('name')),",
				"          email = toString(byName('email')),",
				"          phone = toString(byName('phone')),",
				"          phone_2 = toString(byName('phone_2')),",
				"          address_line_1 = toString(byName('address_line_1')),",
				"          address_line_2 = toString(byName('address_line_2')),",
				"          postalcode = toString(byName('postalcode')),",
				"          city = toString(byName('city')),",
				"          country = toString(byName('country')),",
				"          vat_number = toString(byName('vat_number')),",
				"          reference = toString(byName('reference'))) ~> MapDrifted2",
				"COMPANY derive(id = toInteger(byName('id')),",
				"          name = toString(byName('name'))) ~> MapDrifted3",
				"LOCATIONS derive(product_name = toString(byName('product_name')),",
				"          name = toString(byName('name')),",
				"          subtitle = toString(byName('subtitle')),",
				"          disabled = toBoolean(byName('disabled')),",
