				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceEventsTable",
				"EVENTSREALTIME derive(event_id = toLong(byName('event_id')),",
				"          event_name = toString(byName('event_name')),",
				"          event_status = toString(byName('event_status')),",
				"          event_start = toString(byName('event_start')),",
				"          event_end = toString(byName('event_end')),",
				"          event_guests = toLong(byName('event_guests')),",
				"          company_id = toLong(byName('company_id')),",
				"          planner_id = toLong(byName('planner_id')),",
				"          client_id = toLong(byName('client_id')),",
				"          location_id = toLong(byName('location_id')),",
				"          event_total_price = toDouble(byName('event_total_price')),",
				"          event_total_price_excl_vat = toDouble(byName('event_total_price_excl_vat')),",
				"          created = toString(byName('created')),",
				"          updated = toString(byName('updated')),",
				"          booking_id = toLong(byName('booking_id')),",
				"          reference = toString(byName('reference')),",
