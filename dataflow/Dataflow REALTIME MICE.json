				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['event_id','event_name','activity_id','product_event_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
