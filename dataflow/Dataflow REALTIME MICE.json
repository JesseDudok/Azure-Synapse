				"          cancellation_reason = toString(byName('cancellation_reason')),",
				"          cancellation_note = toString(byName('cancellation_note'))) ~> MapDrifted1",
				"EVENTPRODUCTS select(mapColumn(",
				"          event_id,",
				"          event_name,",
				"          event_status,",
				"          event_start,",
				"          event_end,",
				"          event_guests,",
				"          company_id,",
				"          planner_id,",
				"          client_id,",
				"          event_location_id,",
				"          activity_id,",
				"          activity_name,",
				"          product_id,",
				"          object_type,",
				"          object_id,",
				"          object_code,",
				"          object_category_id,",
				"          product_event_id,",
				"          event_timeline_id,",
				"          event_activity_id,",
				"          event_package_id,",
				"          amount,",
				"          amount_pp,",
				"          product_name,",
				"          subtitle,",
				"          description,",
				"          price,",
				"          price_excl_vat,",
				"          total_price,",
				"          total_price_excl_vat,",
				"          cost_price,",
				"          vat,",
				"          product_source,",
				"          source_file",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"EVENTPACKAGES select(mapColumn(",
				"          event_id,",
				"          event_name,",
				"          event_status,",
				"          company_id,",
				"          planner_id,",
				"          client_id,",
				"          event_location_id,",
				"          package_id,",
				"          package_name,",
				"          package_description,",
				"          package_price,",
				"          package_price_excl_vat,",
				"          package_total_price,",
				"          package_total_price_excl_vat,",
				"          package_source,",
				"          source_file",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"EVENTVATRATES select(mapColumn(",
