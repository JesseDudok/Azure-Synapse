				"          cancellation_reason = toString(byName('cancellation_reason')),",
				"          cancellation_note = toString(byName('cancellation_note'))) ~> MapDriftedEventSource",
				"lookup1 derive(ConfirmedTimestamp = iif(and(equals(MapDrifted1@event_status, 'confirmed'), isNull(ConfirmedTimestamp)), currentTimestamp(), ConfirmedTimestamp),",
				"          CancelledTimestamp = iif(and(equals(MapDrifted1@event_status, 'cancelled'), isNull(CancelledTimestamp)), currentTimestamp(), CancelledTimestamp)) ~> DeriveStatusTimestamps",
				"AlterRow2 sink(allowSchemaDrift: true,",
